.program cmt_rec
.side_set 1

; 2MHz駆動 (1サイクル = 0.5us)
; 1ループ2サイクル = 1us 

    wait 1 pin 0       side 0

.wrap_target
    mov x, ~null       side 1
loop_high:
    jmp x--, next_h    side 1
next_h:
    jmp pin, loop_high side 1
    mov isr, ~x        side 0
    push noblock       side 0

    mov x, ~null       side 0
loop_low:
    jmp pin, went_high side 0
    jmp x--, loop_low  side 0
went_high:
    mov isr, x         side 1
    push noblock       side 1
.wrap